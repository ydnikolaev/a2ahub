# OP-218 `a2a doctor` (basic, no --space): every check PASSes against the
# seeded fixture (credential env var set, mirror cloned, CI workflow file
# present, git on PATH, binary version >= the fixture's min_binary_version).
# `versions` PASSes because the binary is built with -ldflags version
# main_test.go's harnessStampedVersion and the fixture's space.yaml pins
# min_binary_version 0.0.0, well below it. (Wave-5 fix: cmd/a2a/wire.go now
# passes the BARE version to
# DoctorCommand, not the full "a2a x.y.z (sha)" stamp — the stamp made
# doctorVersionOlder's parser fail against any version-pinned space.)
exec a2a doctor
stdout 'credentials: PASS'
stdout 'space access: PASS'
stdout 'space identity: PASS'
stdout 'versions: PASS'
stdout 'CI presence: PASS'
# "space scaffolding current" is the tenth row (this phase's brief): the
# reverse of "versions" — is the SPACE behind what THIS BINARY's embedded
# template would write, not just is the binary too old for the space. It is
# advisory-only (never a FAIL — a behind space still writes fine), so only
# the row name + PASS is asserted here; the note text depends on whether
# cmd/a2a wires DoctorCommand.TemplateFiles (a lead-side wiring step this
# phase reports as needed) and is exercised in full, for all three note
# variants (can-fix / cannot-fix / unknown), by internal/cli's own unit
# tests — this line is only the through-the-binary proof the row exists and
# never reds.
stdout 'space scaffolding current: PASS'
# P45's auto-merge row, in its ADVISORY state: A2A_GITHUB_API is pinned to a
# local 403 fixture (txtar_test.go's Setup), so the repo-settings read cannot
# be answered with this credential. That must render as a PASS carrying an explicit "unverified"
# note — never a silent PASS (which would be a false green over the defect that
# stalled every submit on the live space) and never a FAIL (which would red
# `doctor` for every legitimately narrow-scoped token). Both directions are
# unit-tested in internal/cli; this row is the through-the-binary proof that the
# check exists at all and that its wording is stable.
stdout 'auto-merge enabled: PASS · auto-merge unverified'
stdout 'statusline wiring: PASS'
# local-space-2026-10 P4-B (spec 04 AC18): the `space policy` row names the gates
# mode in force for the space's host and its flow. The seeded fixture is a
# GitHub-hosted space, so its effective mode is `review`; the fixture's flow key
# is absent, which reads as `full`.
stdout 'space policy: PASS · .*: gates review, flow full'

# `--space` is explicitly rejected (v2, D-030) — never silently ignored.
! exec a2a doctor --space
stderr 'not available'

# judge-the-thing-2026-08 P5 (spec 05 §8 #10/#11): "skill manual current" now
# walks the installed tree against THIS BINARY's own embedded skill.Files
# once the stamp names this binary's own version — never a bare stamp-only
# PASS again. §8 #10 requires the STABLE SUBSTRING assertion below and NEVER
# the literal file count: a 36th skill file must red no test but this one,
# and this is not it. Asserting the NOTE rather than just the PASS status is
# the point — a forgotten `cmd.SkillFiles = skill.Files` line in
# cmd/a2a/wire.go degrades to the "wires no embedded skill tree" advisory,
# which this line would catch by NOT matching.
exec a2a skill install
stdout 'installed'
exec a2a doctor
stdout 'skill manual current: PASS · skill manual current \(v'$A2A_STAMPED_VERSION_RE', .* files verified against this binary''s own tree\)'

# §8 #11: delete one reference file the tag ships — seeded on disk with
# `rm`, never by running an older binary (once P4 lands, the bug that used
# to PRODUCE this state cannot reproduce it, and this fixture must outlive
# that bug) — and doctor must FAIL, naming the deleted path, exit 1.
rm .a2ahub/skill/reference/notify.md
! exec a2a doctor
stdout 'skill manual current: FAIL:'
stdout 'reference/notify.md'

# local-space-2026-10 P3 AC11 (local-space-rows): on a project connected ONLY
# to a local space, the rows the GitHub machinery owns print no FAIL and each
# says why it does not apply, and the three local rows pass over a space that
# was just created.
exec a2a skill install
exec a2a space init lone --local --dir spaces/lone.git
rm -r .a2a
exec a2a connect spaces/lone.git
exec a2a doctor
stdout 'credentials: PASS · lone: local space, no credential needed'
stdout 'CI presence: PASS · lone: validated at land, no CI workflow'
stdout 'auto-merge enabled: PASS · lone: lands synchronously'
stdout 'stuck green PRs: PASS · lone: no pull requests'
stdout 'codeowners resolvable: PASS · lone: owners are local:'
stdout 'participant avatars: PASS · lone: local owners render as initials'
stdout 'notify-secret: PASS · lone: no notification delivery on a local space'
stdout 'notify-delivery: PASS · lone: no notification delivery on a local space'
stdout 'local land guard: PASS'
stdout 'local history shape: PASS'
stdout 'local space writable: PASS'
# P4-B: a local space's `gates: default` reads as `confirm` (the host reviews
# nothing); the flow is whatever `space init --local` wrote, so it is not
# pinned here.
stdout 'space policy: PASS · lone: gates confirm, flow (full|express)'
# P4-B (spec 03 §T1.4): a space on this machine is never shared, so repository
# visibility is n/a for it rather than a GitHub probe that cannot answer.
stdout 'repository visibility \[lone\]: PASS: n/a: on this machine, never shared'
! stdout 'FAIL'
! stdout 'UNVERIFIED'


# local-space-2026-10 W6 (P3 audit MED, spec 03 §T1.4): the same local space,
# moved away. host.Open used to read a path it could not find as an unmarked
# GitHub-kind repository, so doctor demanded A2A_TOKEN_LONE, printed git's raw
# "does not appear to be a git repository" with no local hint, and passed the
# three local rows and the space policy over a space nobody read. Now space
# access FAILs with the moved-local-space repair, and every row that needs the
# host says it could not judge.
mv spaces/lone.git spaces/lone-moved.git
! exec a2a doctor
stdout 'space access: FAIL: lone: .*does not exist.*restore it at .*spaces/lone\.git \(a moved local space breaks the write journals'
stdout 'credentials: UNVERIFIED: lone: cannot tell whether this space needs a credential'
stdout 'local land guard: UNVERIFIED: lone: the space''s host could not be opened'
stdout 'local history shape: UNVERIFIED'
stdout 'local space writable: UNVERIFIED'
stdout 'space policy: UNVERIFIED: lone: host not opened'
! stdout 'A2A_TOKEN_'
! stdout 'local land guard: PASS'
! stdout 'space policy: PASS'
