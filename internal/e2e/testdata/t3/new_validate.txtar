# OP-203 `a2a new` + OP-204 `a2a validate`: AC-401.1 — a freshly-minted
# draft passes V1 (schema/frontmatter) BEFORE any hand edit.
#
# category is supplied explicitly (agent-exchange-2026-08 B3, spec
# 03-fill-classes.md §8 AC4): applyFills no longer fills an unreplaced enum
# placeholder with its first alternative, and the surviving `<a|b|c>` token
# fails V1's own schema-class enum check (SCH-002), not just POL-010 — so a
# question draft that must be V1-valid has to choose one, same as title and
# space already do.
exec a2a new question --field title=t --field space=fixture-space --field category=clarification
stdout 'drafted'
exec a2a validate --all
stdout '"valid": true'

# --- and the refusals, because "the verb runs" is not "the verb guards" ---
#
# Added 2026-07-26 after measuring that 14 of 22 scenarios in this tier never
# asserted a refusal at all: a tier where the happy path runs and nothing is
# ever refused certifies that a verb EXISTS, not that it guards anything.

# An unknown artifact type is refused, and the message names what IS known —
# an agent that guessed the type has to be able to correct itself from the
# refusal alone.
! exec a2a new not-a-real-type
stderr 'question'

# A --field override the renderer cannot apply is refused where it is GIVEN,
# never dropped. Dropping it is what made `--field to=beta` fail minutes later
# as a validation complaint about the placeholder it had failed to replace.
! exec a2a new question --field 'to={beta: yes}'
stderr 'field'

# Regression from the first immutable v0.16 candidate: an empty durable actor
# name is a content violation with a stable machine code. It must never escape
# as "unmapped schema-class keyword ... schema/registry drift", which would
# make an agent diagnose the validator instead of repairing its identity.
cp anonymous-actor.md .a2a/staging/anonymous-actor.md
! exec a2a validate --all
stdout 'SCH-009'

# no-silent-yes-2026-08/P3, US-1's own canonical example: `needed_by:
# "next tuesday"` is a declared `format: date` field that internal/schema
# now actually asserts (previously "declared and never asserted" — spec
# 03-a-label-becomes-a-refusal.md §T2), so this refuses at V1 with a
# registered SCH- code rather than validating clean. It must also never
# surface as "unmapped schema-class keyword ... schema/registry drift" —
# internal/validate/schema_class.go's own "format" arm names SCH-012 for
# exactly this keyword, the same discipline SCH-009 above pins for actor.
cp bad-needed-by.md .a2a/staging/bad-needed-by.md
! exec a2a validate --all
stdout 'SCH-012'

