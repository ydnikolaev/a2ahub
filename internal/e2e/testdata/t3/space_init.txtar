# P33 §12 `a2a space init`: scaffold a ready-to-push space tree from the
# EMBEDDED space-template. Two traps this exercises against the real binary:
#   - the embed must carry the dot-directory `.github/` (a plain //go:embed
#     silently drops it, scaffolding a space with no CI at all);
#   - the caller's reusable-workflow ref must pin THIS binary's version, never
#     the version baked into the template (the e2e harness builds with
#     -X main.version=$A2A_STAMPED_VERSION, main_test.go's own
#     harnessStampedVersion, so the pin must come out @v<that version>).
exec a2a space init acme-space
stdout 'wrote 9 files'

# The remaining steps are printed IN ORDER, and the two orderings that brick a
# space when taken early are stated. Both were internal-runbook-only knowledge
# until 2026-07-26, and both fail without naming their cause: a protected empty
# main cannot accept its own bootstrap, and a required check whose pinned
# reusable-workflow release does not exist can never go green. Asserting the
# ORDER rather than merely "some steps printed" is the point — a list that
# silently loses its ordering is the same defect coming back.
stdout 'IN THIS ORDER'
stdout 'push BEFORE arming protection'
stdout 'Allow auto-merge'
stdout 'delete README.md'

# The scaffolded tree carries the CI caller + dependabot — the dotfile-embed trap.
exists acme-space/.github/workflows/a2a-validate.yml
exists acme-space/.github/workflows/a2a-notify.yml
exists acme-space/.github/dependabot.yml
exists acme-space/space.yaml
exists acme-space/CODEOWNERS

# The ref pins the RUNNING binary's version, not the template's baked one.
grep '@v'$A2A_STAMPED_VERSION_RE acme-space/.github/workflows/a2a-validate.yml
grep '@v'$A2A_STAMPED_VERSION_RE acme-space/.github/workflows/a2a-notify.yml

# Space id + write floor were substituted.
grep 'space: acme-space' acme-space/space.yaml
grep 'min_binary_version: '$A2A_STAMPED_VERSION_RE acme-space/space.yaml

# A dev build must NOT scaffold (it would pin a tag that does not exist) —
# covered by the unit tests; here we assert the happy path stays green.

# AC-936.1: the scaffolded space validates green through the real binary.
cd acme-space
exec a2a validate --ci --mode=v3-full-repo
stdout '"valid": true'

# Re-running into a non-empty directory refuses rather than half-overwriting.
cd ..
! exec a2a space init acme-space
stderr 'not empty'

# no-silent-yes-2026-08/P3 stage 2 (D8, spec 03 §8 AC 6/14): the renamed
# sentinel now matches the id grammar's own ordinary branch, so `a2a space
# init` must refuse OUTRIGHT when the given space id equals the sentinel
# — writing a live-looking tree that still carries the template's own
# placeholder as its literal identity would be worse than the old,
# schema-refused shape, not better.
! exec a2a space init replace-with-space-id
stderr 'sentinel'
! exists replace-with-space-id

# sentinel-refused-as-live-space / sentinel-accepted-in-template-ci (spec
# 03 §8 AC 6/7): the UNEDITED space.yaml — sentinel intact, exactly as
# committed at space-template/space.yaml (min_binary_version lowered to
# 0.0.0 here so this fixture's own floor check never depends on which
# release this suite happens to stamp; the identity value under test,
# `space: replace-with-space-id`, is untouched) — swapped into the
# already-scaffolded acme-space tree (every OTHER file there is already
# proven to validate above; only the identity value differs here) STILL
# PASSES `a2a validate --ci`. This is AC 7, not a contradiction of AC 6
# above: D8's sentinel mechanism is a RENAME, not a schema-level ban —
# `replace-with-space-id` is, structurally, an ordinary conforming id, and
# the refusal AC 6 exercises lives in `a2a space init`'s own guard (this
# file's own stanza above), never in `a2a validate`. Tier stated honestly
# at T3, not T6: the real T6 evidence is space-template/.github/workflows/
# a2a-validate.yml running in a live space repo, which no gate in this
# repository can reach; this script runs what that workflow calls, it does
# not prove the workflow ran.
cp unedited-space.yaml acme-space/space.yaml
cd acme-space
exec a2a validate --ci --mode=v3-full-repo
stdout '"valid": true'
cd ..

# no-silent-yes-2026-08 P2b, AC 5: a space whose remote's DEFAULT branch is
# "master" (never "main") gets DERIVED as its push target — never silently
# guessed at "main". Built directly against a bare origin rather than through
# `a2a space init` above: that command only ever scaffolds a LOCAL tree with
# no remote of its own, so it cannot express the shape under test here, which
# is the REMOTE's own refs/remotes/origin/HEAD. mirror_test.go's
# resolveBaseBranchOriginOnBranch and internal/mcp/wire_test.go's
# mcpWireOriginOnBranch build the identical shape for this same phase's
# Go-level proofs; this is its T3, through-the-real-binary counterpart.
env A2A_TOKEN_MASTER_SPACE=master-space-token

# The origin lives under remotes/ rather than bare in $WORK — parseGitHubRepo
# (and its doctor twin doctorRepoOwnerName) split a repo URL on "/" into
# owner/name and refuse a single, slash-free path component, so a bare-in-
# $WORK origin would refuse LOCALLY before ever reaching the funnel's own
# host call, which is not the boundary this stanza means to reach.
mkdir remotes
exec git init --bare -q -b master remotes/master-origin.git
exec git -C remotes/master-origin.git config receive.autogc false

exec git init -q -b master master-seed
cp master-space.yaml master-seed/space.yaml
exec git -C master-seed add space.yaml
exec git -C master-seed commit -q -m seed
exec git -C master-seed remote add origin ../remotes/master-origin.git
exec git -C master-seed push -q origin master

exec a2a connect remotes/master-origin.git
stdout 'registered space "master-space"'

# AC-2 (epic discoverability instrument): `a2a doctor` names the DERIVED
# branch before any submit is attempted — "master-space: master", never
# "main" and never REF-026's own refusal text (a remote that resolves has
# nothing to refuse). This is DIRECT textual proof of derivation through the
# real binary, and doubles as the through-the-binary proof of AC-2 that
# cmd_doctor_test.go's own two new unit tests (fake host, no real exec)
# cannot give by themselves.
#
# `!` (nonzero exit) is real, not defensive: master-space's mirror carries
# only the space.yaml this stanza pushed above, so the UNRELATED "CI
# presence" row FAILs for it (no .github/workflows/a2a-validate.yml) — a
# space-scaffolding fact, not a base-branch one. "default branch healthy"
# itself still PASSes; the assertion below reads that row's own detail.
! exec a2a doctor
stdout 'master-space: master'
! stdout 'REF-026'

mkdir .a2a/staging
cp master-question.md .a2a/staging/master-question.md

# The write funnel reaches PAST base-branch resolution here: CloneOrFetch,
# ResolveBaseBranch (which would refuse REF-026 right at this line if it
# could not derive "master" from the mirror just cloned above), loadManifest
# and credential resolution all succeed — and only then meets this tier's own
# known ceiling (txtar_test.go's own Setup comment): A2A_GITHUB_API is pinned
# to a local 403-only denial fixture, so the funnel's first real host call is
# refused by the fixture, never by this space's base branch. A full `a2a
# submit` SUCCESS needs a real (or fake-but-permissive) GitHub host, which
# this tier deliberately does not wire — so this is the honest T3 ceiling for
# AC 5: proven derivation and proven reach past it, not a faked write. Two
# earlier waves already found this same ceiling and correctly declined to
# fake past it; this stanza asserts exactly what is real: FindPRByHeadBranch
# is the funnel's own FIRST host call (funnel.go step 0, before any
# commit/push git action), so seeing it fail on the fixture's 403 is direct
# proof every step before it — including ResolveBaseBranch — succeeded.
! exec a2a submit .a2a/staging/master-question.md
stderr 'FindPRByHeadBranch'
stderr 'status 403'
! stderr 'REF-026'

-- master-space.yaml --
schema: space/v1
space: master-space
min_binary_version: 0.0.0
participants:
  - system: axon
    section: axon
    status: active
    owners: [axon-bot]
  - system: beta
    section: beta
    status: active
    owners: [beta-bot]

