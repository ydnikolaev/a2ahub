-- unedited-space.yaml --
schema: space/v1
space: replace-with-space-id
min_binary_version: 0.0.0
gates: default
participants: []
notification_routes: []
vendored: []

-- local-tree.txt --
decisions/.gitkeep
space.yaml
vendored/.gitkeep
