# P33 §12 `a2a space init`: scaffold a ready-to-push space tree from the
# EMBEDDED space-template. Two traps this exercises against the real binary:
#   - the embed must carry the dot-directory `.github/` (a plain //go:embed
#     silently drops it, scaffolding a space with no CI at all);
#   - the caller's reusable-workflow ref must pin THIS binary's version, never
#     the version baked into the template (the e2e harness builds with
#     -X main.version=$A2A_STAMPED_VERSION, main_test.go's own
#     harnessStampedVersion, so the pin must come out @v<that version>).
exec a2a space init acme-space
stdout 'wrote 9 files'

# The remaining steps are printed IN ORDER, and the two orderings that brick a
# space when taken early are stated. Both were internal-runbook-only knowledge
# until 2026-07-26, and both fail without naming their cause: a protected empty
# main cannot accept its own bootstrap, and a required check whose pinned
# reusable-workflow release does not exist can never go green. Asserting the
# ORDER rather than merely "some steps printed" is the point — a list that
# silently loses its ordering is the same defect coming back.
stdout 'IN THIS ORDER'
stdout 'push BEFORE arming protection'
stdout 'Allow auto-merge'
stdout 'delete README.md'

# The scaffolded tree carries the CI caller + dependabot — the dotfile-embed trap.
exists acme-space/.github/workflows/a2a-validate.yml
exists acme-space/.github/workflows/a2a-notify.yml
exists acme-space/.github/dependabot.yml
exists acme-space/space.yaml
exists acme-space/CODEOWNERS

# The ref pins the RUNNING binary's version, not the template's baked one.
grep '@v'$A2A_STAMPED_VERSION_RE acme-space/.github/workflows/a2a-validate.yml
grep '@v'$A2A_STAMPED_VERSION_RE acme-space/.github/workflows/a2a-notify.yml

# Space id + write floor were substituted.
grep 'space: acme-space' acme-space/space.yaml
grep 'min_binary_version: '$A2A_STAMPED_VERSION_RE acme-space/space.yaml

# A dev build must NOT scaffold (it would pin a tag that does not exist) —
# covered by the unit tests; here we assert the happy path stays green.

# AC-936.1: the scaffolded space validates green through the real binary.
cd acme-space
exec a2a validate --ci --mode=v3-full-repo
stdout '"valid": true'

# Re-running into a non-empty directory refuses rather than half-overwriting.
cd ..
! exec a2a space init acme-space
stderr 'not empty'

# no-silent-yes-2026-08/P3 stage 2 (D8, spec 03 §8 AC 6/14): the renamed
# sentinel now matches the id grammar's own ordinary branch, so `a2a space
# init` must refuse OUTRIGHT when the given space id equals the sentinel
# — writing a live-looking tree that still carries the template's own
# placeholder as its literal identity would be worse than the old,
# schema-refused shape, not better.
! exec a2a space init replace-with-space-id
stderr 'sentinel'
! exists replace-with-space-id

# sentinel-refused-as-live-space / sentinel-accepted-in-template-ci (spec
# 03 §8 AC 6/7): the UNEDITED space.yaml — sentinel intact, exactly as
# committed at space-template/space.yaml (min_binary_version lowered to
# 0.0.0 here so this fixture's own floor check never depends on which
# release this suite happens to stamp; the identity value under test,
# `space: replace-with-space-id`, is untouched) — swapped into the
# already-scaffolded acme-space tree (every OTHER file there is already
# proven to validate above; only the identity value differs here) STILL
# PASSES `a2a validate --ci`. This is AC 7, not a contradiction of AC 6
# above: D8's sentinel mechanism is a RENAME, not a schema-level ban —
# `replace-with-space-id` is, structurally, an ordinary conforming id, and
# the refusal AC 6 exercises lives in `a2a space init`'s own guard (this
# file's own stanza above), never in `a2a validate`. Tier stated honestly
# at T3, not T6: the real T6 evidence is space-template/.github/workflows/
# a2a-validate.yml running in a live space repo, which no gate in this
# repository can reach; this script runs what that workflow calls, it does
# not prove the workflow ran.
cp unedited-space.yaml acme-space/space.yaml
cd acme-space
exec a2a validate --ci --mode=v3-full-repo
stdout '"valid": true'
cd ..

# local-space-2026-10 P3 AC1 (local-bare-repo): `--local` creates a BARE
# repository, not a tree to push. Its `main` is ONE root commit holding
# exactly the three files a local space needs, and none of the GitHub
# machinery (.github/, CODEOWNERS, BRANCH-PROTECTION.md, README.md): nothing
# on this machine would read them, and CODEOWNERS would name owners that are
# not logins.
exec a2a space init acme --local --dir spaces/acme.git
stdout 'created local space acme at '
exec git --git-dir=spaces/acme.git rev-parse --is-bare-repository
stdout '^true$'
exec git --git-dir=spaces/acme.git rev-list --count main
stdout '^1$'
exec git --git-dir=spaces/acme.git ls-tree -r --name-only main
cmp stdout local-tree.txt

# AC2 (local-push-refused): the guard is armed once the root commit exists,
# so a raw `git push` to main from a clone is refused with the sentence that
# names the way in, while the root commit made before the hook is intact.
exec git clone -q spaces/acme.git clone1
exec git -C clone1 -c user.name=t -c user.email=t@example.invalid commit -q --allow-empty -m 'around the land'
! exec git -C clone1 push origin HEAD:main
stderr 'this local space lands writes only through a2a'
exec git --git-dir=spaces/acme.git rev-list --count main
stdout '^1$'

# The re-run is the repair verb, and is a no-op on a finished space (AC18).
exec a2a space init acme --local --dir spaces/acme.git
stdout 'already created'
exec git --git-dir=spaces/acme.git rev-list --count main
stdout '^1$'

# AC17 (github-default-after-local): the local branch did not leak into the
# default one. The same work dir, the GitHub form, after the local one: nine
# files and the ordered GitHub steps are unchanged.
exec a2a space init acme
stdout 'wrote 9 files'
stdout 'IN THIS ORDER'
stdout 'push BEFORE arming protection'
exists acme/.github/workflows/a2a-validate.yml
exists acme/CODEOWNERS
exists acme/README.md

# no-silent-yes-2026-08 P2b, AC 5: a space whose remote's DEFAULT branch is
# "master" (never "main") gets DERIVED as its push target — never silently
# guessed at "main". Built directly against a bare origin rather than through
# `a2a space init` above: that command only ever scaffolds a LOCAL tree with
# no remote of its own, so it cannot express the shape under test here, which
# is the REMOTE's own refs/remotes/origin/HEAD. mirror_test.go's
# resolveBaseBranchOriginOnBranch and internal/mcp/wire_test.go's
# mcpWireOriginOnBranch build the identical shape for this same phase's
# Go-level proofs; this is its T3, through-the-real-binary counterpart.
env A2A_TOKEN_MASTER_SPACE=master-space-token

# The origin lives under remotes/ rather than bare in $WORK — parseGitHubRepo
# (and its doctor twin doctorRepoOwnerName) split a repo URL on "/" into
# owner/name and refuse a single, slash-free path component, so a bare-in-
# $WORK origin would refuse LOCALLY before ever reaching the funnel's own
# host call, which is not the boundary this stanza means to reach.
mkdir remotes
exec git init --bare -q -b master remotes/master-origin.git
exec git -C remotes/master-origin.git config receive.autogc false

exec git init -q -b master master-seed
cp master-space.yaml master-seed/space.yaml
exec git -C master-seed add space.yaml
exec git -C master-seed commit -q -m seed
exec git -C master-seed remote add origin ../remotes/master-origin.git
exec git -C master-seed push -q origin master

exec a2a connect remotes/master-origin.git
stdout 'registered space "master-space"'

# AC-2 (epic discoverability instrument): `a2a doctor` names the DERIVED
# branch before any submit is attempted — "master-space: master", never
# "main" and never REF-026's own refusal text (a remote that resolves has
# nothing to refuse). This is DIRECT textual proof of derivation through the
# real binary, and doubles as the through-the-binary proof of AC-2 that
# cmd_doctor_test.go's own two new unit tests (fake host, no real exec)
# cannot give by themselves.
#
# `!` (nonzero exit) is real, not defensive: master-space's mirror carries
# only the space.yaml this stanza pushed above, so the UNRELATED "CI
# presence" row FAILs for it (no .github/workflows/a2a-validate.yml) — a
# space-scaffolding fact, not a base-branch one. "default branch healthy"
# itself still PASSes; the assertion below reads that row's own detail.
! exec a2a doctor
stdout 'master-space: master'
! stdout 'REF-026'

mkdir .a2a/staging
cp master-question.md .a2a/staging/master-question.md

# The write funnel reaches PAST base-branch resolution here: CloneOrFetch,
# ResolveBaseBranch (which would refuse REF-026 right at this line if it
# could not derive "master" from the mirror just cloned above), loadManifest
# and credential resolution all succeed — and only then meets this tier's own
# known ceiling (txtar_test.go's own Setup comment): A2A_GITHUB_API is pinned
# to a local 403-only denial fixture, so the funnel's first real host call is
# refused by the fixture, never by this space's base branch. A full `a2a
# submit` SUCCESS needs a real (or fake-but-permissive) GitHub host, which
# this tier deliberately does not wire — so this is the honest T3 ceiling for
# AC 5: proven derivation and proven reach past it, not a faked write. Two
# earlier waves already found this same ceiling and correctly declined to
# fake past it; this stanza asserts exactly what is real: FindPRByHeadBranch
# is the funnel's own FIRST host call (funnel.go step 0, before any
# commit/push git action), so seeing it fail on the fixture's 403 is direct
# proof every step before it — including ResolveBaseBranch — succeeded.
! exec a2a submit .a2a/staging/master-question.md
stderr 'FindPRByHeadBranch'
stderr 'status 403'
! stderr 'REF-026'

# local-space-2026-10 P7-B (spec 07 §6.3, rows 8 to 12): the whole round trip on
# a local space, through the built binary and nothing else. Two repository
# directories, two systems, one bare repository with the land guard. The
# script's setup points A2A_GITHUB_API at a denial fixture and carries a token;
# a local space needs neither, so both are replaced here: the token variables
# are emptied, and the API root becomes a closed port, so a write that wrongly
# reached for GitHub would fail loudly instead of reaching anything. (Emptying
# A2A_GITHUB_API itself would mean api.github.com, which is the opposite.)
# The space keeps the DEFAULT gates (`confirm`): no --gates flag below.
env A2A_GITHUB_API=http://127.0.0.1:1
env FIXTURE_TOKEN=
env A2A_TOKEN_MASTER_SPACE=
cd $WORK
mkdir loop-a
mkdir loop-b
exec a2a space init loop --local --dir spaces/loop.git
stdout 'created local space loop at '

# A joins before B, and B before anything is addressed to it: a space refuses an
# unknown recipient (REF-006), so A's contract below can only name beta once
# beta has joined. A join is a manifest change, G4 under `confirm`, hence
# --approve.
cd $WORK/loop-a
exec a2a init --system axon --space $WORK/spaces/loop.git --no-skill --no-skill-link --no-agents-pointer
exec a2a connect $WORK/spaces/loop.git
stdout 'space "loop" connected; cloned its mirror'
! exec a2a space join
stderr 'G4'
exec a2a space join --approve
stdout 'axon joined loop'
cd $WORK/loop-b
exec a2a init --system beta --space $WORK/spaces/loop.git --no-skill --no-skill-link --no-agents-pointer
exec a2a connect $WORK/spaces/loop.git
exec a2a space join --approve
stdout 'beta joined loop'

# A scaffolds its contract (the schema and both fixtures come from the
# scaffold), then the descriptor and the draft are replaced by the archive's
# copy, whose placeholders are already filled in and which names beta as the
# consumer.
cd $WORK/loop-a
exec a2a contract new export
cp $WORK/export-contract.md .a2a/staging/XC-axon-export.md
cp $WORK/export-contract.md .a2a/staging/axon/provides/export/contract.md

# local-confirm-refuses-unapproved (row 12): the contract enters the space
# through `a2a submit` as a 0.0.0 candidate, which crosses no gate. Its first
# `a2a contract publish` is G1, and in a confirm space it is refused without
# --approve with the registry's POL-029, before anything is prepared: not one
# ref in the space moves, and no branch is left behind.
exec a2a submit .a2a/staging/XC-axon-export.md
stdout 'merged it'
exec a2a sync
exec git --git-dir=$WORK/spaces/loop.git for-each-ref --format='%(refname) %(objectname)'
cp stdout $WORK/refs-before-publish.txt
! exec a2a contract publish --version 1.0.0 --staging .a2a/staging/axon/provides/export XC-axon-export
stderr 'POL-029: G1 requires --approve in a confirm space'
exec git --git-dir=$WORK/spaces/loop.git for-each-ref --format='%(refname) %(objectname)'
cmp stdout $WORK/refs-before-publish.txt

# local-publish-adopt-materialize (row 8): the same publish with --approve
# lands (the land merge commit records the approval), B adopts the contract and
# materializes it, and no step waits for a merge or reaches a network.
exec a2a contract publish --approve --version 1.0.0 --staging .a2a/staging/axon/provides/export XC-axon-export
stdout 'submitted XC-axon-export@1.0.0'
stdout 'gate G1'
exec git --git-dir=$WORK/spaces/loop.git log -1 --first-parent --format=%B main
stdout 'A2A-Approved-Gates: G1'
cd $WORK/loop-b
exec a2a sync
exec a2a contract adopt XC-axon-export
stdout 'merged'
exec git --git-dir=$WORK/spaces/loop.git show main:beta/consumes.yaml
stdout 'XC-axon-export'
exec a2a sync
exec a2a contracts
stdout 'XC-axon-export\taxon\t1.0.0\tpublished'
mkdir vendor
exec a2a contract materialize --to vendor/export --json XC-axon-export@1.0.0
stdout '"outcome":"materialized"'
exists vendor/export/contract.md
exists vendor/export/schema/export.schema.json

# local-concurrent-writes (row 9): each system submits a question to the other,
# started together in the background. Both must land, and the space's
# first-parent history must show one merge commit for each. Which one is first
# is not asserted, only that neither was lost: the host's compare-and-swap
# retries a lost race on a fresh tip.
cd $WORK/loop-a
cp $WORK/q-axon.md .a2a/staging/XQ-axon-20261028-c0a1.md
cd $WORK/loop-b
mkdir .a2a/staging
cp $WORK/q-beta.md .a2a/staging/XQ-beta-20261028-c0b1.md
cd $WORK/loop-a
exec a2a submit .a2a/staging/XQ-axon-20261028-c0a1.md &
cd $WORK/loop-b
exec a2a submit .a2a/staging/XQ-beta-20261028-c0b1.md &
wait
exec git --git-dir=$WORK/spaces/loop.git rev-list --first-parent --merges --count --grep=submit/XQ- main
stdout '^2$'
exec git --git-dir=$WORK/spaces/loop.git log --first-parent --merges --format=%s -2 main
stdout 'submit/XQ-axon-20261028-c0a1'
stdout 'submit/XQ-beta-20261028-c0b1'
exec git --git-dir=$WORK/spaces/loop.git ls-tree -r --name-only main
stdout 'axon/exchanges/XQ-axon-20261028-c0a1.md'
stdout 'beta/exchanges/XQ-beta-20261028-c0b1.md'

# local-raw-push-refused (row 10): a raw `git push` to the space's main from a
# clone of a space that has a history by now is refused by the land guard, with
# the sentence that names the way in, and main does not move. A push to any
# other ref is not this stanza's business.
exec git --git-dir=$WORK/spaces/loop.git rev-parse main
cp stdout $WORK/main-before-raw-push.txt
cd $WORK
exec git clone -q spaces/loop.git loop-raw
exec git -C loop-raw -c user.name=t -c user.email=t@example.invalid commit -q --allow-empty -m 'around the land'
! exec git -C loop-raw push origin HEAD:main
stderr 'this local space lands writes only through a2a'
exec git --git-dir=$WORK/spaces/loop.git rev-parse main
cmp stdout $WORK/main-before-raw-push.txt

# local-express-verdict (row 11): the express flow's three verbs on a local
# space. beta asks for data under the export contract it adopted above, axon
# delivers it with one command, and beta verifies and records the verdict with
# one more. Each verb returns with its write already on main (no step is left
# pending on this host), and `a2a thread` then shows the verdict on the very
# handoff axon delivered, and the request closed. The ids are minted with
# today's date, so they are read back from each verb's own output into files and
# handed to the next verb through `sh -c`; a2a is the last command of every
# `sh -c`, so its exit status is the step's.
cd $WORK/loop-b
exec a2a data request --producer axon --contract XC-axon-export@1.0.0 --interim-behavior 'beta reads the previous export until this lands' --json
stdout '"work_request":"XW-beta-[0-9]{8}-[0-9a-z]{4}"'
stdout '"step":"submit","subject":"XW-beta-[0-9]{8}-[0-9a-z]{4}","transition":"submit","outcome":"landed"'
cp stdout $WORK/express-request.json
exec sh -c 'sed -n "s/.*\"work_request\":\"\(XW-beta-[0-9a-z-]*\)\".*/\1/p" "$WORK/express-request.json" > "$WORK/express-wr.txt"'
grep '^XW-beta-[0-9]{8}-[0-9a-z]{4}$' $WORK/express-wr.txt

cd $WORK/loop-a
mkdir $WORK/express-from
cp .a2a/staging/axon/provides/export/fixtures/valid/export.json $WORK/express-from/export.json
exec sh -c 'a2a data deliver --for "$(cat "$WORK/express-wr.txt")" --from "$WORK/express-from" --profile synthetic --format json'
stdout '^ack +landed +XW-beta-'
stdout '^accept +landed +XW-beta-'
stdout '^pack +landed +DP-axon-'
stdout '^deliver +landed +XH-axon-[0-9]{8}-[0-9a-z]{4} '
stdout '^respond +landed +XW-beta-'
stdout '^next: beta runs: a2a data verify --for XW-beta-[0-9]{8}-[0-9a-z]{4} --record$'
! stdout 'pending|stopped|refused'
cp stdout $WORK/express-deliver.txt
exec sh -c 'sed -n "s/^deliver  *landed  *\(XH-axon-[0-9a-z-]*\) .*/\1/p" "$WORK/express-deliver.txt" > "$WORK/express-xh.txt"'
grep '^XH-axon-[0-9]{8}-[0-9a-z]{4}$' $WORK/express-xh.txt

cd $WORK/loop-b
exec sh -c 'a2a data verify --for "$(cat "$WORK/express-wr.txt")" --record'
stdout '^ack +landed +XH-axon-'
stdout '^verify +landed +XH-axon-'
stdout '^close +landed +XW-beta-'
stdout '^VR-beta-[0-9]{8}-[0-9a-z]{4} verify DP-axon-[0-9]{8}-[0-9a-z]{4}: pass '
! stdout 'pending|stopped|refused'

exec sh -c 'a2a thread "$(cat "$WORK/express-wr.txt")" > "$WORK/express-thread.txt"'
exec sh -c 'grep -F "$(printf "event\tbeta\tverify-pass\t%s" "$(cat "$WORK/express-xh.txt")")" "$WORK/express-thread.txt"'
exec sh -c 'grep -F "$(printf "event\tbeta\tclose\t%s" "$(cat "$WORK/express-wr.txt")")" "$WORK/express-thread.txt"'

-- export-contract.md --
---
schema: envelope/v2
id: XC-axon-export
type: contract
title: The export contract under test
space: loop
from: axon
to: [beta]
actor: {kind: agent, name: e2e}
created: 2026-10-28T16:01:01Z
category: api
priority: p3
blocking: false
classification: internal
version: 0.0.0
schema_format: json-schema-2020-12
compat_policy: default
thread: thread:axon-20261028-mwb1
artifacts:
    - path: schema/export.schema.json
      role: schema
      normative: true
      media_type: application/schema+json
    - path: fixtures/valid/export.json
      role: valid-fixture
      normative: true
      media_type: application/json
      conforms_to: schema/export.schema.json
    - path: fixtures/invalid/export.json
      role: invalid-fixture
      normative: true
      media_type: application/json
      conforms_to: schema/export.schema.json
---
# Export

One paragraph describing the export in the consumer's terms.

## What it covers

Exports, with no deliberate exclusions.

## Error shape

Failures are HTTP status codes.

## Compatibility intent

Fields may be added; none may be removed.

## Owner and support

axon owns it.

