# P9 (spec 09-submit-validates-what-it-carries, fb-20260820-d1e370):
# `a2a submit` promises "validate + open a PR" and carried fifteen sidecars
# it never validated, so the space's own `a2a validate --ci` was the first
# thing to judge them — and it refused one with POL-002, on a file the
# scaffold wrote, the schema mandates the location of, and the role
# vocabulary blesses.
#
# Driven through the BUILT binary because that is what the epic's AC2 asks
# for and because the defect was a disagreement between two halves of ONE
# binary: a unit test on either half alone reproduces neither.
#
# Three claims, in order:
#   1. `validate --all` now judges the tree `a2a submit` would carry, and is
#      GREEN about a declared companion carrying no frontmatter.
#   2. a carried file the descriptor does not declare is refused — by
#      `validate --all` and by `a2a submit`, locally, before any network
#      call, with the carried list printed.
#   3. removing that file makes both verbs green again, so the refusal is a
#      classification rather than a suppression.

mkdir .a2a/staging
mkdir .a2a/staging/axon/provides/companion-feed/schema
mkdir .a2a/staging/axon/provides/companion-feed/fixtures/valid
mkdir .a2a/staging/axon/provides/companion-feed/fixtures/invalid
mkdir .a2a/staging/axon/provides/companion-feed/artifacts
cp contract.md .a2a/staging/XC-axon-companion-feed.md
cp schema.json .a2a/staging/axon/provides/companion-feed/schema/companion-feed.schema.json
cp valid.json .a2a/staging/axon/provides/companion-feed/fixtures/valid/companion-feed.json
cp invalid.json .a2a/staging/axon/provides/companion-feed/fixtures/invalid/companion-feed.json
cp CHANGELOG.md .a2a/staging/axon/provides/companion-feed/artifacts/CHANGELOG.md

# 1. `--all` reaches the carried set. Before P9 this was a NON-recursive
#    readDir of the staging root filtered to top-level *.md: it reported ONE
#    line here and said nothing at all about the four files about to travel.
exec a2a validate --all
stdout 'CHANGELOG.md'
stdout 'companion-feed.schema.json'
! stdout '"valid": false'

# 2. an undeclared carried file: named locally, in a second, rather than as
#    a CI annotation on a PR that is already dead.
cp NOTES.md .a2a/staging/axon/provides/companion-feed/artifacts/NOTES.md
! exec a2a validate --all
stdout 'POL-013'
stdout 'NOTES.md'

! exec a2a submit .a2a/staging/XC-axon-companion-feed.md
stderr 'POL-013'
stderr 'NOTES.md'
# S-6: the carried list is printed on the REFUSAL path, with each file's
# classification. It existed before this phase and was printed only on
# success — which is the report's own core complaint.
stderr 'carried file\(s\)'
stderr 'declared-companion'
stderr 'undeclared-companion'

# 3. and it is a classification, not a suppression: remove the undeclared
#    file and the same two verbs are green again.
rm .a2a/staging/axon/provides/companion-feed/artifacts/NOTES.md
exec a2a validate --all
stdout '"valid": true'
! stdout 'POL-013'

# 4. no-silent-yes-2026-08 P5, ACs 5 and 7 in one stanza, through the BUILT
#    binary because both claims are about what the shipped schema accepts.
#
#    `to: all` on a contract: legal, and D6 moved the PLAN to say so rather
#    than moving the schema to forbid it (05-schemas.md, 03-domain.md). A
#    contract is addressed to the SPACE; the next consumer to join is equally
#    entitled, and `to: [axon]` implied a bilateral scope the artifact does
#    not have. An external consumer filed a breaking-change request in July
#    2026 for exactly this, because it shipped and nothing said so.
#
#    And all three new `x_` fields at once, well-formed, plus an `x_` key
#    NOTHING declares. The undeclared key is the load-bearing one: it is what
#    a binary built BEFORE this phase does with `x_identity`, so its passing
#    is the evidence that no `min_binary_version` move is owed.
mkdir .a2a/staging/axon/provides/broadcast-feed/schema
cp broadcast.md .a2a/staging/XC-axon-broadcast-feed.md
cp schema.json .a2a/staging/axon/provides/broadcast-feed/schema/broadcast-feed.schema.json
exec a2a validate --all
stdout '"valid": true'

-- broadcast.md --
