{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event/v2/event.schema.json",
  "title": "Lifecycle event (v2)",
  "description": "A distinct event/v2 corpus object. First-party contract publish events carry an immutable digest profile and durable publication identity; event/v1 remains unchanged for historical replay and ordinary lifecycle writers.",
  "type": "object",
  "properties": {
    "schema": { "const": "event/v2" },
    "event": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "space": { "type": "string" },
    "subject": { "type": "string" },
    "transition": {
      "type": "string",
      "enum": [
        "create", "publish", "deprecate", "retire", "acknowledge",
        "satisfy", "decline", "withdraw", "supersede", "submit",
        "accept", "start", "block", "unblock", "respond", "close",
        "dispute", "cancel", "propose", "approve", "reject",
        "verify-pass", "verify-fail", "verify", "note"
      ]
    },
    "state": { "type": "string" },
    "actor": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["human", "agent"] },
        "name": { "type": "string", "minLength": 1 },
        "system": { "type": "string" },
        "model": { "type": "string" },
        "session": { "type": "string" }
      },
      "required": ["kind", "name", "system"],
      "additionalProperties": false
    },
    "at": { "type": "string", "format": "date-time" },
    "note": { "type": "string" },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["ref"],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "reason_code": {
      "type": "string",
      "enum": ["split-required", "security-concern", "out-of-scope", "duplicate", "other"]
    },
    "commit": { "type": "string" },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "digest_profile": {
      "type": "string",
      "enum": ["contract-tree-v1", "contract-set-v2"]
    },
    "publication": {
      "type": "object",
      "properties": {
        "intent_key": {
          "type": "string",
          "pattern": "^op-v1-[a-f0-9]{64}$"
        },
        "candidate_intent_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "version_selector": {
          "type": "string",
          "pattern": "^(auto:(patch|minor|major)|explicit:(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$"
        },
        "operation_key": {
          "type": "string",
          "pattern": "^op-v1-[a-f0-9]{64}$"
        }
      },
      "required": [
        "intent_key",
        "candidate_intent_digest",
        "version_selector",
        "operation_key"
      ],
      "additionalProperties": false
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["tool", "version"],
      "additionalProperties": false
    },
    "verdicts": {
      "type": "array",
      "description": "P6 wave C (docs/features/active/agent-exchange-2026-08/specs/06-incompleteness.md §7/§11, threat-model.md T5, readiness audit row 25): the verifier's own mirror of a response's `unmet[]` (envelope/v2/response.schema.json) — one entry per judged criterion, indexed into the SAME parent `acceptance_criteria[]` by the same grammar (never restated in prose), so a false verdict has a named author (`cause_owner`) rather than living only in a transition-free note. Conditionally required on `verify`/`close` below. Index-range validation against the parent is internal/validate's job (REF-019), not this schema's — mirroring how `unmet[]`'s own range check (REF-018) lives off envelope/v2/response.schema.json too.",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Index into the parent's acceptance_criteria[] this verdict judges — the same by-index grammar unmet[] uses, checked for range by REF-019."
          },
          "verdict": {
            "type": "string",
            "enum": ["met", "unmet", "not_warranted", "not_exercised"]
          },
          "cause_owner": {
            "type": "string",
            "minLength": 1,
            "description": "Who the verifier holds responsible for a non-met verdict — the attributability T5 names as its only discharge. Present on every entry, including `met` ones, so the array cannot mix attributed and unattributed judgements."
          }
        },
        "required": ["index", "verdict", "cause_owner"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "event", "space", "subject", "transition", "actor", "at"],
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": { "pattern": "^XC-" },
          "transition": { "const": "publish" }
        },
        "required": ["subject", "transition"]
      },
      "then": {
        "required": ["version", "digest", "digest_profile", "publication"]
      }
    },
    {
      "if": {
        "properties": {
          "transition": { "enum": ["verify", "close"] }
        },
        "required": ["transition"]
      },
      "then": {
        "description": "T5's discharge: a verify or close over a parent's acceptance criteria must name a per-criterion verdict, not leave the judgement in prose. No minItems floor — a close over a parent that declares no acceptance_criteria[] at all must stay expressible with an empty array.",
        "required": ["verdicts"]
      }
    }
  ],
  "additionalProperties": false
}
