{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope/v2/work_request.schema.json",
  "title": "Envelope: work_request (v2)",
  "description": "A work request carrying the v1 shape plus attachments[]: bytes moving WITH the request, addressed by digest, without implying a contract pin or a fulfilled deliver. P5's binding lands on this same file (D3).",
  "allOf": [
    { "$ref": "base.schema.json" },
    {
      "if": {
        "properties": {
          "category": {
            "enum": ["contract-change", "process-change"]
          }
        },
        "required": ["category"]
      },
      "then": {
        "required": ["proposed_change", "refs"],
        "properties": {
          "refs": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "@"
                }
              },
              "required": ["ref"]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["blocking"],
        "properties": {
          "blocking": { "const": false }
        }
      },
      "then": {
        "required": ["interim_behavior"]
      }
    }
  ],
  "type": "object",
  "properties": {
    "type": { "const": "work_request" },
    "id": { "pattern": "^XW-" },
    "category": {
      "type": "string",
      "enum": [
        "data",
        "feature",
        "fix",
        "investigation",
        "contract-change",
        "process-change",
        "other"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "proposed_change": { "type": "string" },
    "to": {
      "description": "Exchange type (X class, not decision): exactly one target system.",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 1
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Content-addressed blob id."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "role": { "type": "string" },
          "conforms_to": {
            "type": "string",
            "pattern": "^XC-.+@[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "verification": {
            "type": "string",
            "enum": ["required", "offered", "none"]
          },
          "retention": {
            "oneOf": [
              { "const": "pinned" },
              {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
              }
            ]
          }
        },
        "required": ["ref", "digest", "verification", "retention"],
        "additionalProperties": false
      }
    }
  },
  "required": ["category", "acceptance_criteria"],
  "patternProperties": { "^x_": true },
  "unevaluatedProperties": false
}
