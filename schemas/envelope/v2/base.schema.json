{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope/v2/base.schema.json",
  "title": "Envelope base (v2)",
  "description": "Common frontmatter fields for envelope/v2 artifact types. This separately compiled base preserves the v1 common field meanings while giving v2 concrete schemas a version-local reference target.",
  "type": "object",
  "properties": {
    "schema": { "const": "envelope/v2" },
    "id": {
      "type": "string",
      "description": "Identity per the-plan §3.3: standing = <PREFIX>-<system>-<slug>; exchange/broadcast = <PREFIX>-<system>-<YYYYMMDD>-<rand4>. Per-type schemas narrow the prefix further.",
      "pattern": "^(XC|XR)-[a-z0-9]+-[A-Za-z0-9]+(-[A-Za-z0-9]+)*$|^(XQ|XW|XD|XH|XS|XA)-[a-z0-9]+-[0-9]{8}-[0-9abcdefghjkmnpqrstvwxyz]{4}$"
    },
    "type": {
      "type": "string",
      "enum": ["contract", "requirement", "question", "work_request", "decision", "response", "handoff", "announcement"]
    },
    "title": { "type": "string", "maxLength": 120 },
    "space": { "type": "string" },
    "from": { "type": "string" },
    "to": {
      "description": "[system ID] for exchanges/standing types, or 'all' for broadcasts (per-type schemas further constrain cardinality).",
      "oneOf": [
        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        { "const": "all" }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["human", "agent"] },
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "session": { "type": "string" }
      },
      "required": ["kind", "name"],
      "additionalProperties": false
    },
    "created": { "type": "string", "format": "date-time" },
    "priority": { "type": "string", "enum": ["p1", "p2", "p3", "p4"] },
    "blocking": { "type": "boolean" },
    "needed_by": { "type": "string", "format": "date" },
    "effort_estimate": { "type": "string", "enum": ["xs", "s", "m", "l", "xl"] },
    "expected_response": {
      "type": "object",
      "properties": {
        "shape": { "type": "string" },
        "by": { "type": "string", "format": "date" }
      },
      "required": ["shape"],
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "defects-fix-2026-08 P3: HOMOGENEOUS — either every entry is a plain string (the original, ordinal-addressed form) or every entry is a {id, text} object (the id-addressed form); a mixed array has no single addressing mode and is refused. Per-type schemas (e.g. work_request) may narrow this further.",
      "anyOf": [
        { "items": { "type": "string" } },
        {
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable, minted at authoring; never reused within one artifact."
              },
              "text": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "text"],
            "additionalProperties": false
          }
        }
      ]
    },
    "thread": {
      "type": "string",
      "description": "Correlation ID per the-plan §3.8: the conversation this artifact belongs to. Minted by the tool (`a2a new`) and inherited by every derived artifact, so an author never types one. Same rand4 alphabet as the `id` pattern above. REQUIRED since P46 — every artifact is on a thread, which is what makes an incomplete conversation impossible to mistake for a complete one.",
      "pattern": "^thread:[a-z0-9]+-[0-9]{8}-[0-9abcdefghjkmnpqrstvwxyz]{4}$"
    },
    "supersedes": { "type": "string" },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["ref"],
        "additionalProperties": false
      }
    },
    "origin": { "type": "array", "items": { "type": "string" } },
    "migrated_from": { "type": "string" },
    "interim_behavior": { "type": "string" },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "restricted"],
      "default": "internal"
    },
    "valid_until": { "type": "string", "format": "date" }
  },
  "required": [
    "schema", "id", "type", "title", "space", "from", "to", "actor",
    "created", "priority", "blocking", "classification", "thread"
  ]
}
