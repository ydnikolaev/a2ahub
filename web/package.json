{
  "name": "a2ahub-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-home-copy.mjs --check && node scripts/generate-content.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-home-copy.mjs --check && node scripts/generate-content.mjs",
    "build": "astro build",
    "build:dashboard": "node scripts/build-local-dashboard.mjs",
    "sync:preview-tokens": "node scripts/sync-preview-tokens.mjs",
    "sync:home-copy": "node scripts/sync-home-copy.mjs",
    "check": "npm run prebuild && npm run check:unit && npm run build && node scripts/check-dist.mjs",
    "precheck:unit": "node scripts/generate-content.mjs",
    "check:unit": "node --test --experimental-strip-types tests/*.test.mjs",
    "check:a11y": "playwright test",
    "check:lighthouse": "node scripts/audit-lighthouse.mjs",
    "check:quality": "npm run check && npm run check:a11y && npm run check:lighthouse",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.0",
    "@lucide/astro": "^1.28.0",
    "astro": "^7.1.1",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-vitals": "^6.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "lighthouse": "^13.4.1",
    "vite": "^8.1.5"
  }
}
