# The lane deriver's ungated list (P12). Public for the same reason internal/lane
# is: a public checkout that has the derivation but not the file recording which
# paths are deliberately outside it would refuse on every one of them. Same
# directory trap as scripts/installsh below — `scripts/*` excludes the DIRECTORY
# scripts/lib, so the directory must be re-included and its contents re-excluded
# before a single file can be named. gate-lib.sh deliberately stays private.
!scripts/lib/
scripts/lib/*
!scripts/lib/lane-ungated.txt
!scripts/tests/
scripts/tests/*
!scripts/tests/check_contract_carried_set_test.sh
!scripts/tests/check_event_writer_receipts_test.sh
!scripts/tests/check_live_e2e_evidence_test.sh
!scripts/tests/check_localserver_readonly_routes_test.sh
!scripts/tests/check_operational_projection_single_source_test.sh
!scripts/tests/check_work_checkpoint_schema_test.sh
!scripts/tests/check_human_gates_test.sh
!scripts/tests/check_loop_reachability_test.sh
!scripts/tests/check_loop_coverage_test.sh
!scripts/releasebody/
# install.sh's regression net (P40 AC-1002.*). A directory, not a file: `scripts/*`
# excludes the DIRECTORY `scripts/installsh`, and git cannot re-include a file whose
# parent directory is excluded — so `!scripts/installsh/install_test.go` alone would
# silently not work. Public for the same reason install.sh is: it is the proof the
# installer still wires a shell, and a test that ships only on one machine is not one.
!scripts/installsh/
